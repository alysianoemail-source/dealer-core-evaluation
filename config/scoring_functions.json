{
  "version": "v0.2",
  "last_updated": "2026-07-26",
  "description": "经销商核企测评 — 全量指标评分函数配置。每个指标定义原始值→0-100分的映射规则，基于商业银行供应链金融风控逻辑设计。",

  "_design_principles": {
    "1": "每个指标独立评分，用线性插值在阈值断点间平滑过渡",
    "2": "行业差异通过 industry_profiles 覆盖默认阈值实现",
    "3": "非上市企业财务数据用代理指标+降权系数替代",
    "4": "所有阈值基于业务逻辑设计（非统计回归），需持续迭代校准",
    "5": "离散型指标（纳税评级等）用 lookup 表，不走插值"
  },

  "industry_profiles": {
    "consumer_electronics": {
      "name": "消费电子",
      "lifecycle": "growth_to_mature",
      "revenue_growth_thresholds": [15, 90, 10, 80, 5, 65, 0, 45, -5, 25],
      "inventory_turnover_thresholds": [8, 90, 6, 80, 4, 65, 2, 45, 1, 25],
      "gross_margin_typical": "15-30%"
    },
    "home_appliances": {
      "name": "家用电器",
      "lifecycle": "mature",
      "revenue_growth_thresholds": [10, 90, 5, 80, 0, 65, -5, 45, -10, 25],
      "inventory_turnover_thresholds": [6, 90, 4, 75, 3, 60, 2, 40, 1, 20],
      "gross_margin_typical": "25-35%"
    },
    "new_energy": {
      "name": "新能源",
      "lifecycle": "growth",
      "revenue_growth_thresholds": [25, 95, 15, 85, 10, 75, 5, 55, 0, 35],
      "inventory_turnover_thresholds": [5, 85, 4, 75, 3, 60, 2, 45, 1, 25],
      "gross_margin_typical": "20-40%"
    }
  },

