          [15, 100], [10, 90], [5, 80], [0, 65], [-5, 45], [-10, 25]
        ]
      },

      "_price_volume_adjustment": {
        "description": "量价同看修正规则：先对3个量价指标独立打分+等权平均，再根据量价方向对整体做一次性修正（非逐指标修正）。",
        "rules": {
          "volume_up_price_up": { "label": "需求拉动上行", "adjustment": 3, "per_indicator": false },
          "volume_up_price_down": { "label": "供给扩张(量增价跌)", "adjustment": -2, "per_indicator": false },
          "volume_down_price_up": { "label": "供给收缩(量跌价涨)", "adjustment": -2, "per_indicator": false },
          "volume_down_price_down": { "label": "需求萎缩下行", "adjustment": -8, "per_indicator": false }
        }
      }
