          [15, 100], [10, 90], [5, 80], [0, 65], [-5, 45], [-10, 25], [-20, 10]
        ],
        "industry_overrides": {
          "home_appliances": [[10, 100], [5, 90], [0, 75], [-5, 55], [-10, 35], [-15, 15]],
          "new_energy": [[25, 100], [15, 90], [10, 80], [5, 60], [0, 40], [-5, 20]]
        }
      },

      "d1_profit_growth": {
        "id": "d1_profit_growth",
